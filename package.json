{
  "name": "telemetry-ops-copilot",
  "version": "0.1.0",
  "description": "AI operations assistant for an IoT device fleet: MCP server + hand-written agent loop with guardrails, tracing and evals.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "mcp:stdio": "tsx src/server/stdio.ts",
    "mcp:http": "tsx src/server/http-main.ts",
    "agent": "tsx src/agent/cli.ts",
    "demo": "tsx scripts/demo.ts",
    "serve": "tsx src/agent/http-main.ts",
    "viewer:screenshot": "tsx scripts/screenshot-viewer.ts",
    "eval": "tsx evals/run.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "test:e2e": "tsx scripts/e2e-web.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run eval -- --check && git diff --exit-code evals/results.json evals/results.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.14.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
