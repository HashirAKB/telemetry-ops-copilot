# Optional. When set, the agent can use the real Anthropic API (--provider anthropic).
# Without it, everything (tests, evals, demo) runs on the deterministic MockProvider.
ANTHROPIC_API_KEY=
# Model used by AnthropicProvider.
ANTHROPIC_MODEL=claude-opus-5-5
# SQLite database path created by `npm run seed`.
DB_PATH=data/fleet.db
# Agent-side SQLite file: run history and approval audit log.
AGENT_DB_PATH=data/agent.db
# Optional: also export traces via OTLP/HTTP JSON, e.g. an OTel Collector or Jaeger.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Port for the MCP Streamable HTTP server.
MCP_PORT=3001
# Bearer token for the MCP HTTP endpoint (recommended). Empty = no auth, local use only.
MCP_API_TOKEN=
# 1 = do not register write tools (create_incident, restart_device) at all.
MCP_READ_ONLY=
# Port for the agent HTTP API (chat + approvals).
AGENT_PORT=3000
# Bearer token required on /api/* (recommended). Empty = no auth, local use only.
AGENT_API_TOKEN=
